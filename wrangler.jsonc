{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "llm-agent",
	"compatibility_flags": ["nodejs_compat"],
	"compatibility_date": "2026-05-26",
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"main": ".open-next/worker.js",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"workers_dev": false,
	"preview_urls": false,
	"keep_vars": true
}
